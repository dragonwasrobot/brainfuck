{
  "name": "brainfuck",
  "version": "1.0.0",
  "description": "A brainfuck interpreter written in Elm",
  "dependencies": {
    "elm-format": "=0.8.8",
    "elm-verify-examples": "=6.0.3",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "css": "pnpm exec tailwindcss -i docs/style.css -o docs/main.css",
    "compile": "elm make --debug --output=docs/elm.min.js src/Main.elm",
    "serve": "cd docs && python3 -m http.server",
    "format": "pnpm exec elm-format --validate src",
    "test": "pnpm exec elm-test tests",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.8.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/cli": "^4.3.3",
    "elm-test": "^0.19.1-revision17",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3"
  }
}
